// TCR-specific tasks do not invoke ARTIC, Guppyplex, Kraken2, or viral lineage tools.
// Dorado is an external, pinned installation; point tcr_dorado_bin at its full path.
params {
    tcr_dorado_bin = 'dorado'
    tcr_samtools_bin = 'samtools'
    tcr_dorado_version = '2.1.2'
    tcr_basecall_device = 'cuda:0'
    tcr_polish_device = 'cpu'
    tcr_polish_models = null
    tcr_qc_config = null
    tcr_expected_pairs = 48
    tcr_barcode_errors = 1
    tcr_allow_empty_pod5 = false
    tcr_save_basecalls = true
}
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    withLabel: 'tcr_cpu' {
        cpus = 4
        memory = '8 GB'
        time = '8h'
    }
    withLabel: 'tcr_gpu' {
        cpus = 8
        memory = '32 GB'
        time = '48h'
        maxForks = 1
    }
    withLabel: 'tcr_polish' {
        cpus = 4
        memory = '16 GB'
        time = '12h'
    }
}
profiles {
    tcr_conda {
        conda.enabled = true
        process {
            withLabel: 'tcr_.*' {
                conda = "${projectDir}/assets/tcr_pod5/environment.yml"
            }
        }
    }
}
